# Copy to .env.local and fill in from Supabase: Project Settings → API.
# Without these the app uses the local data in data/landmarks.ts.

# Used by the app (public: safe in the browser, Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by scripts/test-rls.ts (creates and deletes two test users).
# Secret: never commit it, never add it to Vercel, never import it in app code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
